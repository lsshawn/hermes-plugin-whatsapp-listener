# Runtime state written by the bot on each box — never part of the plugin source.
# Kept out of git so `hermes plugins update` (git pull) never conflicts with a
# client's live whitelist/admins/paused config.
state.yaml

# Session backups the relink flow creates.
*.bak.*
session.bak.*

# Python
__pycache__/
*.pyc

# Legacy per-file state from older plugin versions (pre state.yaml).
whitelist.txt
admins.txt
admin_groups.txt
paused_chats.json
_migrated_backup/
